{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hito-uno",
  "compatibility_date": "2026-08-24",
  // El Worker resuelve los perfiles /p/<slug>, las redirecciones de objetos
  // /o/<id> y el panel /panel/<token> + /api/panel/*. Ver worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sin esto, una navegacion del navegador a /p/<slug> o /panel/<token>
    // (que no existen como archivo) recibe el fallback SPA —la landing—
    // antes de que el Worker llegue a correr. Con estas rutas el Worker
    // corre primero y decide.
    "run_worker_first": ["/p/*", "/o/*", "/panel/*", "/api/*"]
  },
  // Almacen del panel: destinos de cada objeto y tokens de acceso.
  // Un Durable Object con SQLite se crea solo con la migracion de abajo: no
  // hay que crear nada a mano en el panel de Cloudflare.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "HitoStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HitoStore"] }],
  // Conteo de toques por objeto (Analytics Engine). El dataset aparece solo
  // con el primer dato, pero la cuenta tiene que tener Analytics Engine
  // habilitado UNA vez desde el panel, si no el deploy falla con el error
  // 10089. Para activarlo:
  //   1. https://dash.cloudflare.com/dd0c1cd27f121745346add33faf4eceb/workers/analytics-engine
  //      -> Enable.
  //   2. Descomentar este bloque y el de env.dev.
  // Mientras tanto el Worker funciona igual, sin contar.
  // "analytics_engine_datasets": [{ "binding": "TOQUES", "dataset": "hito_toques" }],
  "routes": [
    {
      "pattern": "hito.uno",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "hito-uno-dev",
      // Los bindings no se heredan entre entornos: hay que repetirlos aca.
      "durable_objects": {
        "bindings": [{ "name": "STORE", "class_name": "HitoStore" }]
      },
      // "analytics_engine_datasets": [{ "binding": "TOQUES", "dataset": "hito_toques_dev" }],
      "routes": [
        {
          "pattern": "dev.hito.uno",
          "custom_domain": true
        }
      ]
    }
  }
}
