{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hito-uno",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "hito.uno",
      "custom_domain": true
    }
  ]
}
