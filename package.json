{
  "name": "hito-uno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --env dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "map:refresh": "node scripts/maps/fetch-map.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "check:entornos": "node scripts/check-entornos.mjs",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "deploy:production": "npm run deploy",
    "check": "npm run check:paths && tsc -b && vite build && npm run test && npm run check:entornos"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.125.0"
  }
}
