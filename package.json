{
  "name": "hito-uno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --env dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "map:refresh": "node scripts/maps/fetch-map.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "check:entornos": "node scripts/check-entornos.mjs",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "deploy:production": "npm run deploy",
    "check": "npm run check:paths && tsc -b && vite build && npm run check:entornos"
  },
  "dependencies": {
    "@react-three/fiber": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
